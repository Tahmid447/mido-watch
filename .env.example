NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-or-hosted-publishable-key

# Server only: TMDb Settings → API → API Read Access Token (long Bearer token).
TMDB_READ_ACCESS_TOKEN=
# Alternative: use the v3 API Key instead. Set one credential, not both.
TMDB_API_KEY=
